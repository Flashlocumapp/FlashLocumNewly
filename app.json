{
  "expo": {
    "name": "FlashLocum",
    "slug": "flashlocum",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.flashlocum.app",
      "newArchEnabled": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSCameraUsageDescription": "FlashLocum uses your camera during profile setup to take your profile photo and when uploading verification documents such as your medical licence and NYSC certificate.",
        "NSPhotoLibraryUsageDescription": "FlashLocum needs access to your photo library to let you upload profile photos and documents.",
        "NSPhotoLibraryAddUsageDescription": "FlashLocum needs permission to save photos to your library.",
        "NSLocationWhenInUseUsageDescription": "Your location is used to show nearby coverage requests on the map and help requesters find available doctors in your area.",
        "NSUserNotificationUsageDescription": "FlashLocum uses notifications to alert you about new coverage requests, shift updates, and payment confirmations."
      },
      "config": {
        "googleMapsApiKey": "AIzaSyBFC2FPkzjooOJhFwkMsM_o3qQiTOn0rZk"
      }
    },
    "android": {
      "package": "com.flashlocum.app",
      "newArchEnabled": true,
      "minSdkVersion": 24,
      "versionCode": 11,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#111315"
      },
      "navigationBar": {
        "backgroundColor": "#F9F9F6",
        "barStyle": "dark-content"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyACeTm0j_ajj-rRObPbkDBJvW6GVBt6SMU"
        }
      }
    },
    "web": {
      "favicon": "./assets/images/newly.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "ios": {
            "backgroundColor": "#111315",
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 255,
            "resizeMode": "contain"
          },
          "android": {
            "backgroundColor": "#111315",
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 480,
            "resizeMode": "contain"
          }
        }
      ],
      "expo-font",
      "expo-router",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your location is used to show nearby coverage requests on the map and help requesters find available doctors in your area."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "onesignal-expo-plugin",
        {
          "mode": "production"
        }
      ]
    ],
    "scheme": "flashlocum",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "backendUrl": "https://bm7mn4rkap7zw8ax5ddfbmfaz9q8m3ru.app.specular.dev",
      "oneSignalAppId": "78be9474-8dc2-43cb-b23a-b78121f533c1",
      "supabaseUrl": "https://juilousufwlsiqdcgllu.supabase.co",
      "supabaseAnonKey": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imp1aWxvdXN1Zndsc2lxZGNnbGx1Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODI3MjE1MTEsImV4cCI6MjA5ODI5NzUxMX0.XOE0UTfZrfLp_giDlGkBsffhRBhVT1njaETm7vtmTxA"
    }
  }
}