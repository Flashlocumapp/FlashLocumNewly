          "android": {
            "image": "./assets/images/splash-fullscreen.png",
            "resizeMode": "contain",
            "backgroundColor": "#2B2B2B",
            "imageWidth": 250
          }
        }
      ],
      "expo-font",
      "expo-router",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "FlashLocum needs your location to show you nearby doctors and allow doctors to find you.",
