{
  "expo": {
    "name": "FlashLocum",
    "slug": "flashlocum",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-fullscreen.png",
      "resizeMode": "contain",
      "backgroundColor": "#2B2B2B"
    },
    "ios": {
      "newArchEnabled": true,
      "supportsTablet": true,
      "bundleIdentifier": "com.flashlocum.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSCameraUsageDescription": "FlashLocum needs camera access to let you upload your credentials and profile photo.",
        "NSPhotoLibraryUsageDescription": "FlashLocum needs photo library access to let you select your credentials and profile photo.",
        "NSPhotoLibraryAddUsageDescription": "FlashLocum needs permission to save photos to your library.",
        "NSLocationWhenInUseUsageDescription": "FlashLocum needs your location to show you nearby doctors and allow doctors to find you."
      },
      "config": {
        "googleMapsApiKey": "AIzaSyBF\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022"
      }
    },
    "android": {
      "newArchEnabled": true,
      "minSdkVersion": 24,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "READ_MEDIA_IMAGES",
        "android.permission.ACCESS_FINE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#1a1a1a"
      },
      "package": "com.flashlocum.app",
      "versionCode": 10,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyACeTm0j_ajj-rRObPbkDBJvW6GVBt6SMU"
        }
      },
      "navigationBar": {
        "backgroundColor": "#F9F9F6",
        "barStyle": "dark-content"
      },
      "splash": {
        "image": "./assets/images/splash-fullscreen.png",
        "resizeMode": "contain",
        "backgroundColor": "#2B2B2B"
      }
    },
    "web": {
      "favicon": "./assets/images/newly.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "ios": {
            "image": "./assets/images/splash-fullscreen.png",
            "resizeMode": "contain",
            "backgroundColor": "#2B2B2B",
            "imageWidth": 180
